# Nexus Platform — environment variables (copy to .env and adjust).
# Never commit a real .env (it is gitignored).

# HTTP server port
PORT=8080

# Browser origins allowed to call the API with credentials. CORS is FAIL-CLOSED: leave this
# empty and every browser request is refused, so nexus-web loads as a blank page. Dev FE runs
# on :3000 (`preview_start nexus-web`). Comma-separated for more than one origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Behind a reverse proxy (Caddy), the networks it reaches the API from, comma-separated. Only these may
# vouch for X-Forwarded-For; empty = the direct peer is the client. Behind a proxy and empty, the per-IP
# brakes (login, SSO, failed nxk_/nxm_ lookups) see one client: the proxy. docker-compose.yml sets it.
# TRUSTED_PROXY_CIDRS=10.213.47.0/24

# MySQL 8 DSN (Go format). Matches docker-compose's local dev DB. REQUIRED — the server refuses to
# start without it (there is no built-in default). loc=UTC: the DB stores timestamps in UTC, and
# loc=Local on a +07 machine labels them with the local offset → every instant 7h off (R2-03).
DATABASE_URL=root:@tcp(127.0.0.1:3306)/nexus_platform?charset=utf8mb4&parseTime=True&loc=UTC

# JWT signing secret — HS256 requires AT LEAST 32 bytes (RFC 7518 §3.2); a 16–31 byte value
# fails fast at boot. CHANGE THIS to a random 32+ byte string (never use a default).
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# "Xem như vai" session lifetime in whole minutes (specs/064-preview-as-role-sample-data), 1..60,
# default 30. Out of range or not a number ⇒ the server refuses to boot (it bounds a token that
# carries another role). No refresh, no extension: when it expires the builder reopens it.
#PREVIEW_TTL_MINUTES=30

# Redis (cache + task queue)
REDIS_URL=redis://127.0.0.1:6379

# ── AI (E9 Builder + ⌘K assistant) ─────────────────────────────────────────────
# AI is honest-disabled by default (every AI surface answers 503 AI_DISABLED).
# To turn it ON, set BOTH of these — a gateway must actually be reachable:
#AI_ENABLED=true
# Any OpenAI-compatible /v1/chat/completions gateway works (LiteLLM, vLLM, Ollama, a hosted endpoint).
# Calls are streamed with stream_options.include_usage, so the ledger gets the whole input; a gateway
# that ignores stream and answers one JSON body works too.
#AI_GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
# Put the real key in .env only (never commit it). The model id must be one the gateway lists (GET /v1/models):
#AI_GATEWAY_API_KEY=
#AI_MODEL=claude-opus-5-5
# Tool-loop depth per turn (Discovery mode needs ~14; default 12):
#AI_MAX_STEPS=14
# Probe: GET /api/v1/ai/health → {"data":{"enabled":true|false}} — the FE reads this
# to show an honest on/off state BEFORE the user types.
# Record/replay, for demos, CI and evals without a live model: live (default) | record | replay.
# record talks to the gateway and writes every exchange to the cassette, one JSON line each; the first
# exchange that succeeds replaces the old file, so a boot that records nothing keeps it. The key is
# never written, but prompts and what the tools read are: record demo data.
# replay answers from the cassette with no network, base URL or key (AI_ENABLED=true still needed) and
# reports zero tokens, so rehearsals spend no budget. Each call must match its recording (same agent,
# same prompt, same steps) or it fails with 502 AI_GATEWAY_ERROR saying the cassette is stale: re-record.
# An unknown mode, record/replay without a cassette, a cassette with live mode, or a cassette that
# cannot be opened stops the server at boot. Under docker compose: ./cassettes, mounted at /cassettes.
#AI_GATEWAY_MODE=replay
#AI_GATEWAY_CASSETTE=../cassettes/demo-loop.jsonl

# Background scheduler for "scheduled" workflows + BPM SLA. ON by default (60 s); set 0 to turn
# it off (Studio then warns on scheduled rules). Demo uses 5:
#WORKFLOW_SCHEDULER_INTERVAL_SEC=60

# Email actions (workflow email_alert silently NO-OPs while this is off):
#ALERTS_ENABLED=true
#SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS= SMTP_FROM=

# ── Kho khoá kết nối — named credentials (specs/050) ──────────────────────────
# Master key sealing every partner credential (AES-256-GCM). Absent = the vault stays inert
# (API 503 CREDENTIALS_NOT_CONFIGURED; webhooks that use a stored key send nothing). A malformed
# value fails boot. Generate: `openssl rand -base64 32`. Losing it = losing every stored partner key.
#CREDENTIAL_ENC_KEY=
# Label [a-z0-9]{1,23}; the sealing id is "<label>.<8 hex fingerprint of the key>".
#CREDENTIAL_ENC_KEY_ID=v1
# Master-key rotation only: decrypt-only old keys "id:base64,id:base64" (never the active id).
#CREDENTIAL_ENC_RETIRED_KEYS=
# Accept plain-http partner URLs to non-loopback hosts — dev / docker network ONLY, never prod.
#CREDENTIAL_ALLOW_INSECURE_HTTP=false
