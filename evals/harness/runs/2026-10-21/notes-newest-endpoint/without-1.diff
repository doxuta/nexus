+// Newest returns the most recent live note on (entityName, recordID), or nil when the record has
+// none — the record header's "latest note" without loading a page. Same RecordGuard gate as List:
+// a caller who may not view the parent record gets that EXACT error, never a note.
+func (s *Service) Newest(ctx context.Context, scope services.RecordScope, tenantID, entityName, recordID string) (*Note, error) {
+	canonical, _, err := s.guard.ResolveNoteTarget(ctx, scope, tenantID, entityName, recordID)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := s.repo.ListByRecord(ctx, tenantID, canonical, recordID, 1, 0)
+	if err != nil {
+		return nil, fmt.Errorf("notes.Service.Newest: %w", err)
+	}
+	if len(rows) == 0 {
+		return nil, nil
+	}
+	return &rows[0], nil
 }
 
