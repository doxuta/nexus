+// GET /:entity/:id/notes/newest → {data: note | null} — the record header's latest note without
+// loading the Notes tab. null = no note yet; 404 when the caller cannot view the record.
+export async function getNewestRecordNote(entity: string, recordId: string): Promise<RecordNote | null> {
+  const r = await req<{ data: RecordNote | null }>(
+    "GET", `/${encodeURIComponent(entity)}/${encodeURIComponent(recordId)}/notes/newest`,
+  );
+  return r.data ?? null;
+}
