+  let originalFetch: typeof fetch;
+  beforeEach(async () => {
+    originalFetch = global.fetch;
+    global.fetch = vi.fn(async () => new Response(null, { status: 204 })) as unknown as typeof fetch;
+    await logout();
+    window.localStorage.clear();
+    window.sessionStorage.clear();
