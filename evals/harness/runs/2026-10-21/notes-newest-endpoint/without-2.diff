+// Newest handles GET /:entity/:id/notes/newest — {"data": note} or {"data": null} when the record
+// has no live note (200 either way; a record the caller cannot view is the List 404).
+func (h *NoteHandler) Newest(c *gin.Context) {
+	tenantID, ok := tenantOf(c)
+	if !ok {
+		return
+	}
+	entity := strings.TrimSpace(c.Param("entity"))
+	recordID := strings.TrimSpace(c.Param("id"))
+
+	n, err := h.svc.Newest(c.Request.Context(), scopeOf(c), tenantID, entity, recordID)
+	if err != nil {
+		h.respondError(c, err, "Newest")
+		return
+	}
+	if n == nil {
+		c.JSON(http.StatusOK, gin.H{"data": nil})
+		return
+	}
+	dtos := h.toDTOs(c.Request.Context(), tenantID, []notes.Note{*n})
+	c.JSON(http.StatusOK, gin.H{"data": dtos[0]})
 }
 
