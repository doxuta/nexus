+// GET /:entity/:id/notes/newest rides the SAME "view" floor as the notes list, and answers
+// {"data": null} (200) when the record has no note — the header must not treat "none" as an error.
+func TestNoteACLWiring_NewestRequiresView(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	tests := []struct {
+		name     string
+		levels   map[string]string
+		wantCode int
+	}{
+		{"chỉ Xem (của mình) ⇒ đọc được", map[string]string{"view": "owner"}, http.StatusOK},
+		{"chỉ có Tạo, không có Xem ⇒ 403", map[string]string{"create": "all"}, http.StatusForbidden},
+		{"không có grant nào ⇒ 403", map[string]string{}, http.StatusForbidden},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var got services.RecordScope
+			ver := &stubVerifier{byToken: map[string]*auth.Claims{"ktv": claimsFor("t1", "role-ktv", false)}}
+			r := gin.New()
+			r.Use(gin.Recovery())
+			RegisterAPIRoutes(r.Group("/api/v1"), ver, levelPerActionChecker{entity: "phieu_sua_chua", levels: tt.levels}, APIHandlers{
+				Record: NewDynamicRecordHandler(nil, zap.NewNop()),
+				Note:   NewNoteHandler(noteSpy{got: &got}, zap.NewNop()),
+			}, zap.NewNop())
+
+			req := httptest.NewRequest(http.MethodGet, "/api/v1/phieu_sua_chua/r1/notes/newest", nil)
+			req.Header.Set("Authorization", "Bearer ktv")
+			rec := httptest.NewRecorder()
+			r.ServeHTTP(rec, req)
+
+			if rec.Code != tt.wantCode {
+				t.Fatalf("status = %d, want %d (body=%s)", rec.Code, tt.wantCode, rec.Body.String())
+			}
+			if tt.wantCode != http.StatusOK {
+				return
+			}
+			if body := rec.Body.String(); body != `{"data":null}` {
+				t.Errorf("body = %s, want {\"data\":null}", body)
+			}
+			if got.AccessLevel != "owner" {
+				t.Errorf("newest handler received access level %q, want the view grant's %q", got.AccessLevel, "owner")
+			}
+		})
+	}
+}
