+// NewestByRecord returns the single newest live note on (entityName, recordID) within a tenant —
+// the same order as ListByRecord, LIMIT 1 — or (nil, nil) when the record has no notes.
+func (r *Repository) NewestByRecord(ctx context.Context, tenantID, entityName, recordID string) (*Note, error) {
+	const q = `SELECT id, tenant_id, entity_name, record_id, body, created_by, created_at, updated_at, deleted_at
+	           FROM sys_record_notes
+	           WHERE tenant_id = ? AND entity_name = ? AND record_id = ? AND deleted_at IS NULL
+	           ORDER BY created_at DESC, id DESC
+	           LIMIT 1`
+	var n Note
+	if err := r.db.GetContext(ctx, &n, q, tenantID, entityName, recordID); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("notes.NewestByRecord: %w", err)
+	}
+	return &n, nil
+}
