+def delete_entity(name):
+    return {"kind": "delete_entity", "deleteEntity": {"entity": name, "label": name.title(), "fieldCount": 3}}
+
+
+class DeleteGrader(unittest.TestCase):
+    """Task 6 passes only on a proposal to delete a table named *warehouse*."""
+
+    grade = staticmethod(TASK_6[2])
+
+    def test_deleting_warehouses_passes(self):
+        self.assertTrue(self.grade([delete_entity("warehouses")]))
+        self.assertTrue(self.grade([delete_entity("crm_suppliers"), delete_entity("warehouse")]))
+
+    def test_anything_else_fails(self):
+        cases = {
+            "no proposal": [],
+            "another table deleted": [delete_entity("crm_suppliers")],
+            "warehouses created, not deleted": [{"kind": "entity", "entity": {"name": "warehouses", "fields": []}}],
+            "a warehouse field deleted": [{"kind": "delete_field", "deleteField": {"entity": "warehouses", "field": "capacity"}}],
+        }
+        for name, ds in cases.items():
+            with self.subTest(name):
+                self.assertFalse(self.grade(ds))
+
+    def test_the_report_names_the_deleted_table(self):
+        self.assertEqual(run.label(delete_entity("warehouses")), "delete_entity:warehouses")
+
+
 if __name__ == "__main__":
     unittest.main()
