+def delete_entity(name):
+    """A delete_entity proposal as the builder session returns it (ai.DraftItem)."""
+    return {"kind": "delete_entity", "deleteEntity": {"entity": name, "label": name.title(), "fieldCount": 4}}
+
+
+class DeleteTask(unittest.TestCase):
+    TASK_6 = next(t for t in run.TASKS if t[0] == 6)
+
+    def grade(self, drafts):
+        return self.TASK_6[2](drafts)
+
+    def test_the_request(self):
+        self.assertEqual(self.TASK_6[1], "Remove the Warehouses table.")
+
+    def test_a_proposal_to_delete_the_warehouses_table_passes(self):
+        self.assertTrue(self.grade([delete_entity("warehouses")]))
+        self.assertTrue(self.grade([{"kind": "field", "field": {"entity": "crm_contacts", "name": "x"}}, delete_entity("warehouses")]))
+
+    def test_anything_else_fails(self):
+        for name, drafts in {
+            "no proposal": [],
+            "another table deleted": [delete_entity("crm_contacts")],
+            "a warehouses table created": [{"kind": "entity", "entity": {"name": "warehouses", "fields": []}}],
+            "a field of warehouses deleted": [{"kind": "delete_field", "deleteField": {"entity": "warehouses", "field": "address"}}],
+        }.items():
+            with self.subTest(name):
+                self.assertFalse(self.grade(drafts))
+
+    def test_the_report_names_the_deleted_table(self):
+        self.assertEqual(run.label(delete_entity("warehouses")), "delete_entity:warehouses")
+
+
 if __name__ == "__main__":
     unittest.main()
