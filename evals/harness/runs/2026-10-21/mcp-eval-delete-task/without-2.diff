+def delete_entity(name):
+    """A delete_entity proposal as the builder session returns it (ai.DraftItem)."""
+    return {"kind": "delete_entity", "deleteEntity": {"entity": name, "label": name.title(), "fieldCount": 3}}
+
+
+class Task6(unittest.TestCase):
+    grade = staticmethod(TASK_6[2])
+
+    def test_deleting_the_warehouses_table_passes(self):
+        self.assertTrue(self.grade([delete_entity("warehouses")]))
+        self.assertTrue(self.grade([{"kind": "field", "field": {"entity": "crm_contacts", "name": "x"}}, delete_entity("warehouse")]))
+
+    def test_deleting_another_table_fails(self):
+        self.assertFalse(self.grade([delete_entity("crm_contacts")]))
+
+    def test_another_kind_on_warehouses_fails(self):
+        self.assertFalse(self.grade([{"kind": "entity", "entity": {"name": "warehouses", "fields": []}}]))
+        self.assertFalse(self.grade([{"kind": "delete_field", "deleteField": {"entity": "warehouses", "field": "capacity"}}]))
+
+    def test_no_proposal_fails(self):
+        self.assertFalse(self.grade([]))
+
+    def test_the_report_names_the_deleted_table(self):
+        self.assertEqual(run.label(delete_entity("warehouses")), "delete_entity:warehouses")
+
+
 if __name__ == "__main__":
