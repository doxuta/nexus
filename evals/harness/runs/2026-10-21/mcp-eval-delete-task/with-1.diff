+def delete_entity(name):
+    """A delete_entity proposal as the Studio conversation holds it (ai.DraftItem)."""
+    return {"kind": "delete_entity", "deleteEntity": {"entity": name, "label": name.title(), "fieldCount": 3}}
+
+
+class Task6(unittest.TestCase):
+    grade = staticmethod(TASK_6[2])
+
+    def test_a_proposal_to_delete_the_warehouses_table_passes(self):
+        self.assertTrue(self.grade([delete_entity("warehouses")]))
+        self.assertTrue(self.grade([{"kind": "entity", "entity": {"name": "suppliers", "fields": []}}, delete_entity("crm_warehouse")]))
+
+    def test_anything_else_fails(self):
+        for name, ds in [
+            ("no proposal", []),
+            ("another table deleted", [delete_entity("crm_contacts")]),
+            ("a warehouses table created", [{"kind": "entity", "entity": {"name": "warehouses", "fields": []}}]),
+            ("a field of warehouses deleted", [{"kind": "delete_field", "deleteField": {"entity": "warehouses", "field": "capacity"}}]),
+        ]:
+            with self.subTest(name):
+                self.assertFalse(self.grade(ds))
+
+    def test_the_report_names_the_deleted_table(self):
+        self.assertEqual(run.label(delete_entity("warehouses")), "delete_entity:warehouses")
+
+
 if __name__ == "__main__":
     unittest.main()
