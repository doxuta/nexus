+//go:build integration
+
+package notes_test
+
+import (
+	"fmt"
+	"os"
+	"testing"
+
+	"nexus/platform/internal/ittest"
+)
+
+// packageTestDSN points every notes integration test at a self-provisioned, migrated throwaway
+// database set by TestMain below (same shape as internal/files). Its initial value is a valid-shaped
+// default so that, when MySQL is unreachable, the connect helper fails on Connect and Skips.
+var packageTestDSN = "root:@tcp(127.0.0.1:3306)/nexus_platform?parseTime=true&multiStatements=true"
+
+func TestMain(m *testing.M) {
+	input := os.Getenv("TEST_DATABASE_URL")
+	if input == "" {
+		input = packageTestDSN
+	}
+	thr, cleanup, skip, err := ittest.Setup(input, "nexus_notes_it", "../../migrations")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "notes integration setup failed: %v\n", err)
+		os.Exit(1)
+	}
+	// Never fall back to the shared dev database on a skip.
+	packageTestDSN = input
+	if !skip {
+		packageTestDSN = thr
+	}
+	code := m.Run()
+	if cleanup != nil {
+		cleanup()
+	}
+	os.Exit(code)
+}
