+//go:build integration
+
+// Real-MySQL regression test: records imported with ids from an old system can share the same
+// (entity, record id) across two tenants, so the Notes tab must list and count only the caller's
+// tenant's notes. Run with:
+//
+//	go test -tags=integration -run TestRepository_SameRecordIDAcrossTenants ./internal/notes/
+package notes_test
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	_ "github.com/go-sql-driver/mysql"
+	"github.com/jmoiron/sqlx"
+
+	"nexus/platform/internal/notes"
+)
+
+const (
+	ntTenantA = "aaaa1111-0000-0000-0000-00000000ee01"
+	ntTenantB = "bbbb2222-0000-0000-0000-00000000ee02"
+	ntRecord  = "cccc3333-0000-0000-0000-00000000ee03" // the SAME imported id in both tenants
+)
+
+func TestRepository_SameRecordIDAcrossTenants(t *testing.T) {
+	db, err := sqlx.Connect("mysql", packageTestDSN)
+	if err != nil {
+		t.Skipf("MySQL not reachable (%v) — skipping integration test", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+	ctx := context.Background()
+	clean := func() {
+		if _, err := db.ExecContext(ctx, "DELETE FROM sys_record_notes WHERE tenant_id IN (?, ?)", ntTenantA, ntTenantB); err != nil {
+			t.Fatalf("clean: %v", err)
+		}
+	}
+	clean()
+	t.Cleanup(clean)
+
+	repo := notes.NewRepository(db)
+	now := time.Now().UTC().Truncate(time.Second)
+	insert := func(id, tenant, body string) {
+		if err := repo.Insert(ctx, notes.Note{
+			ID: id, TenantID: tenant, EntityName: "crm_accounts", RecordID: ntRecord,
+			Body: body, CreatedBy: "user-1", CreatedAt: now, UpdatedAt: now,
+		}); err != nil {
+			t.Fatalf("Insert %s: %v", id, err)
+		}
+	}
+	insert("dddd0000-0000-0000-0000-00000000ee0a", ntTenantA, "note of tenant A")
+	insert("dddd0000-0000-0000-0000-00000000ee0b", ntTenantB, "note of tenant B")
+	insert("dddd0000-0000-0000-0000-00000000ee0c", ntTenantB, "another note of tenant B")
+
+	rows, err := repo.ListByRecord(ctx, ntTenantA, "crm_accounts", ntRecord, 20, 0)
+	if err != nil {
+		t.Fatalf("ListByRecord: %v", err)
+	}
+	if len(rows) != 1 || rows[0].TenantID != ntTenantA || rows[0].Body != "note of tenant A" {
+		t.Errorf("tenant A notes = %+v; want only its own note", rows)
+	}
+	total, err := repo.CountByRecord(ctx, ntTenantA, "crm_accounts", ntRecord)
+	if err != nil {
+		t.Fatalf("CountByRecord: %v", err)
+	}
+	if total != 1 {
+		t.Errorf("tenant A count = %d; want 1", total)
+	}
+
+	rows, err = repo.ListByRecord(ctx, ntTenantB, "crm_accounts", ntRecord, 20, 0)
+	if err != nil {
+		t.Fatalf("ListByRecord: %v", err)
+	}
+	for _, n := range rows {
+		if n.TenantID != ntTenantB {
+			t.Errorf("tenant B saw a note of tenant %s: %+v", n.TenantID, n)
+		}
+	}
+	if len(rows) != 2 {
+		t.Errorf("tenant B notes = %d; want 2", len(rows))
+	}
+}
