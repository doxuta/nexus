+//go:build integration
+
+package notes
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	_ "github.com/go-sql-driver/mysql"
+	"github.com/jmoiron/sqlx"
+
+	"nexus/platform/internal/ittest"
+)
+
+// testDSN points the integration tests at the throwaway migrated database TestMain provisions from
+// TEST_DATABASE_URL. The default only matters when MySQL is unreachable: connect fails and the tests Skip.
+var testDSN = "root:@tcp(127.0.0.1:3306)/nexus_platform?charset=utf8mb4&parseTime=True&loc=Local"
+
+func TestMain(m *testing.M) {
+	input := os.Getenv("TEST_DATABASE_URL")
+	if input == "" {
+		input = testDSN
+	}
+	thr, cleanup, skip, err := ittest.Setup(input, "nexus_notes_it", "../../migrations")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "notes integration setup failed: %v\n", err)
+		os.Exit(1)
+	}
+	testDSN = input
+	if !skip {
+		testDSN = thr
+	}
+	code := m.Run()
+	if cleanup != nil {
+		cleanup()
+	}
+	os.Exit(code)
+}
+
+// Imported records keep their legacy ids, so two tenants can hold the SAME (entity, record_id).
+// Listing/counting one tenant's notes must never return the other's.
+func TestNotesRepository_SameRecordIDAcrossTenants_Integration(t *testing.T) {
+	db, err := sqlx.Connect("mysql", testDSN)
+	if err != nil {
+		t.Skipf("MySQL not reachable (%v) — skipping", err)
+	}
+	t.Cleanup(func() { _ = db.Close() })
+
+	const (
+		tenantA  = "n1000000-0000-0000-0000-00000000000a"
+		tenantB  = "n1000000-0000-0000-0000-00000000000b"
+		entity   = "crm_accounts"
+		recordID = "r1000000-0000-0000-0000-000000000001"
+	)
+	ctx := context.Background()
+	t.Cleanup(func() { db.Exec("DELETE FROM sys_record_notes WHERE tenant_id IN (?, ?)", tenantA, tenantB) })
+	repo := NewRepository(db)
+	now := time.Now().UTC().Truncate(time.Second)
+	for i, n := range []Note{
+		{ID: "n1000000-0000-0000-0000-0000000000a1", TenantID: tenantA, Body: "A1"},
+		{ID: "n1000000-0000-0000-0000-0000000000b1", TenantID: tenantB, Body: "B1"},
+		{ID: "n1000000-0000-0000-0000-0000000000b2", TenantID: tenantB, Body: "B2"},
+	} {
+		n.EntityName, n.RecordID, n.CreatedBy = entity, recordID, "u1000000-0000-0000-0000-000000000001"
+		n.CreatedAt = now.Add(time.Duration(i) * time.Second)
+		n.UpdatedAt = n.CreatedAt
+		if err := repo.Insert(ctx, n); err != nil {
+			t.Fatalf("Insert %s: %v", n.ID, err)
+		}
+	}
+
+	rows, err := repo.ListByRecord(ctx, tenantA, entity, recordID, 20, 0)
+	if err != nil {
+		t.Fatalf("ListByRecord: %v", err)
+	}
+	if len(rows) != 1 || rows[0].TenantID != tenantA || rows[0].Body != "A1" {
+		t.Errorf("tenant A notes = %+v; want only A1", rows)
+	}
+	total, err := repo.CountByRecord(ctx, tenantA, entity, recordID)
+	if err != nil {
+		t.Fatalf("CountByRecord: %v", err)
+	}
+	if total != 1 {
+		t.Errorf("tenant A count = %d; want 1", total)
+	}
+}
