+package handlers
+
+// note_dto_test.go — no DB, no build tag. Locks the note wire shape: every note carries its
+// "pinned" flag as a plain boolean, false included (not omitted), so the client never has to guess.
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"go.uber.org/zap"
+
+	"nexus/platform/internal/notes"
+)
+
+func TestNoteDTO_CarriesPinned(t *testing.T) {
+	h := NewNoteHandler(nil, zap.NewNop())
+	out := h.toDTOs(context.Background(), "tenant-a", []notes.Note{
+		{ID: "n1", Body: "ghim", Pinned: true},
+		{ID: "n2", Body: "thường"},
+	})
+	raw, err := json.Marshal(out)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	var got []map[string]any
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if len(got) != 2 || got[0]["pinned"] != true || got[1]["pinned"] != false {
+		t.Errorf("wire = %s; want pinned true on n1 and false (present) on n2", raw)
+	}
+}
