@@ -0,0 +1,14 @@
+-- Reverse 000100: drop sys_record_notes.pinned. Notes survive; only the pin is lost and the list falls
+-- back to newest first.
+DROP PROCEDURE IF EXISTS _notes100_revert;
+CREATE PROCEDURE _notes100_revert()
+BEGIN
+    IF EXISTS (
+        SELECT 1 FROM information_schema.COLUMNS
+        WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'sys_record_notes' AND COLUMN_NAME = 'pinned'
+    ) THEN
+        ALTER TABLE sys_record_notes DROP COLUMN pinned;
+    END IF;
+END;
+CALL _notes100_revert();
+DROP PROCEDURE IF EXISTS _notes100_revert;
--- /dev/null
+++ b/nexus-platform/migrations/000100_record_notes_pinned.up.sql
@@ -0,0 +1,20 @@
+-- Pinned record notes: a builder pins an important note so it stays at the top of a record's notes
+-- (internal/notes.Repository.ListByRecord orders pinned DESC first, newest first within each group).
+-- Off by default, so every existing note stays unpinned and its order is unchanged. Setting the flag
+-- (API/UI) is a later change; this migration only stores it.
+--
+-- ONE ALTER statement, guarded by information_schema (MySQL 8 has no ADD COLUMN IF NOT EXISTS): DDL
+-- auto-commits, so a single statement cannot leave a half-applied (dirty) migration.
+DROP PROCEDURE IF EXISTS _notes100_apply;
+CREATE PROCEDURE _notes100_apply()
+BEGIN
+    IF NOT EXISTS (
+        SELECT 1 FROM information_schema.COLUMNS
+        WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'sys_record_notes' AND COLUMN_NAME = 'pinned'
+    ) THEN
+        ALTER TABLE sys_record_notes
+            ADD COLUMN pinned TINYINT(1) NOT NULL DEFAULT 0 AFTER body;
+    END IF;
+END;
+CALL _notes100_apply();
+DROP PROCEDURE IF EXISTS _notes100_apply;
