@@ -0,0 +1,31 @@
+package handlers
+
+// note_handler_test.go — the note wire shape, no DB, no build tag: every note carries an explicit
+// "pinned" boolean (false included), so the client can tell an unpinned note from an old server.
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"nexus/platform/internal/notes"
+)
+
+func TestNoteHandler_toDTOs_Pinned(t *testing.T) {
+	h := NewNoteHandler(nil, nil)
+	dtos := h.toDTOs(context.Background(), "tenant-a", []notes.Note{
+		{ID: "note-1", Body: "ghim", Pinned: true},
+		{ID: "note-2", Body: "thường"},
+	})
+	raw, err := json.Marshal(dtos)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	var got []map[string]any
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if len(got) != 2 || got[0]["pinned"] != true || got[1]["pinned"] != false {
+		t.Errorf("pinned on the wire = %s; want true then an explicit false", raw)
+	}
+}
