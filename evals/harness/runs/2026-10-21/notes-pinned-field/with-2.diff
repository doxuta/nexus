+package handlers
+
+// note_dto_test.go — the wire shape always carries "pinned" (true or false, never omitted), so the
+// notes tab can tell a pinned note from an unpinned one without guessing from a missing key.
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"nexus/platform/internal/notes"
+)
+
+func TestNoteDTO_PinnedAlwaysOnTheWire(t *testing.T) {
+	h := NewNoteHandler(nil, nil)
+	dtos := h.toDTOs(context.Background(), "t1", []notes.Note{
+		{ID: "n1", Body: "ghim", Pinned: true},
+		{ID: "n2", Body: "thường"},
+	})
+	for i, want := range []string{`"pinned":true`, `"pinned":false`} {
+		b, err := json.Marshal(dtos[i])
+		if err != nil {
+			t.Fatalf("marshal: %v", err)
+		}
+		if !strings.Contains(string(b), want) {
+			t.Errorf("dto[%d] = %s; want it to contain %s", i, b, want)
+		}
+	}
+}
