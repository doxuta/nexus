@@ -0,0 +1,19 @@
+-- Record notes can be pinned: a pinned note stays at the top of the record's notes (ListByRecord
+-- orders pinned DESC before created_at DESC). Off by default, so every existing note stays unpinned;
+-- setting the flag (API/UI) is a later change.
+--
+-- ONE ALTER statement, guarded by information_schema (MySQL 8 has no ADD COLUMN IF NOT EXISTS): DDL
+-- auto-commits, so a single statement cannot leave a half-applied (dirty) migration.
+DROP PROCEDURE IF EXISTS _notes100_apply;
+CREATE PROCEDURE _notes100_apply()
+BEGIN
+    IF NOT EXISTS (
+        SELECT 1 FROM information_schema.COLUMNS
+        WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'sys_record_notes' AND COLUMN_NAME = 'pinned'
+    ) THEN
+        ALTER TABLE sys_record_notes
+            ADD COLUMN pinned TINYINT(1) NOT NULL DEFAULT 0 AFTER body;
+    END IF;
+END;
+CALL _notes100_apply();
+DROP PROCEDURE IF EXISTS _notes100_apply;
