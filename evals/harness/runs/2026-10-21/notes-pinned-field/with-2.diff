+-- Reverse 000100: drop the pinned flag of sys_record_notes. Notes keep their body and order falls
+-- back to newest first.
+DROP PROCEDURE IF EXISTS _notes100_revert;
+CREATE PROCEDURE _notes100_revert()
+BEGIN
+    IF EXISTS (
+        SELECT 1 FROM information_schema.COLUMNS
+        WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'sys_record_notes' AND COLUMN_NAME = 'pinned'
+    ) THEN
+        ALTER TABLE sys_record_notes DROP COLUMN pinned;
+    END IF;
+END;
+CALL _notes100_revert();
+DROP PROCEDURE IF EXISTS _notes100_revert;
