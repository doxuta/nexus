+package handlers
+
+// note_dto_test.go — the note wire shape carries `pinned` on every note, false included (not
+// omitted), so the client can tell an unpinned note from an old server. No DB, no build tag.
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"go.uber.org/zap"
+
+	"nexus/platform/internal/notes"
+)
+
+func TestNoteDTO_Pinned(t *testing.T) {
+	h := NewNoteHandler(nil, zap.NewNop())
+	dtos := h.toDTOs(context.Background(), "tenant-a", []notes.Note{
+		{ID: "n1", Body: "quan trọng", Pinned: true},
+		{ID: "n2", Body: "bình thường"},
+	})
+	raw, err := json.Marshal(dtos)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	var got []map[string]any
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("got %d notes; want 2 (%s)", len(got), raw)
+	}
+	if got[0]["pinned"] != true {
+		t.Errorf("n1 pinned = %v; want true (%s)", got[0]["pinned"], raw)
+	}
+	if v, ok := got[1]["pinned"]; !ok || v != false {
+		t.Errorf("n2 pinned = %v (present=%v); want false, present (%s)", v, ok, raw)
+	}
+}
